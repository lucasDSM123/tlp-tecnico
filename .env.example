# Banco do NOVO projeto no Neon (nao e o mesmo do dashboard).
# Sem isso, o app usa um SQLite local (so para testes).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Chave que assina o cookie de sessao. OBRIGATORIA em producao.
# Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# producao = cookie so via HTTPS; dev = permite http://localhost
AMBIENTE=dev

# 1 quando estiver atras de proxy (Render, Railway, Fly): le o IP real do X-Forwarded-For
CONFIAR_PROXY=0

# Use "null" em hospedagem serverless (ex.: Vercel) para nao prender conexoes
DB_POOL=
